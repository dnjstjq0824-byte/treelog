# TreeBlog console (Vite SPA) production image. Build with e.g.:
#   docker build -f Dockerfile.console --build-arg APP=blog-console -t treeblog/blog-console .
ARG APP=blog-console
FROM node:24-alpine AS build
ARG APP
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/${APP} ./apps/${APP}
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @treeblog/${APP} build

FROM nginx:1.27-alpine
ARG APP
COPY infra/docker/console-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -q -O- http://127.0.0.1/ || exit 1
