# Local development only. Copy to .env and replace every placeholder.
# Generate values with: ./infra/dev/generate-keys.sh  (or .ps1 on Windows)
POSTGRES_PASSWORD=replace-with-a-long-local-password
MINIO_ROOT_USER=replace-with-local-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-local-secret

# RS256 signing key for access tokens. Points at a PEM file inside the
# container (mounted from ./infra/dev) or an absolute host path for
# `go run ./cmd/api`.
TREEBLOG_JWT_PRIVATE_KEY_PATH=/run/secrets/treeblog/jwt_rsa
TREEBLOG_JWT_ISSUER=https://treeblog.local
TREEBLOG_JWT_AUDIENCE=treeblog-web

# Base64-encoded 32+ byte pepper for email codes and MFA secret storage.
# Generate: openssl rand -base64 32
TREEBLOG_CODE_PEPPER=replace-with-base64-encoded-32-byte-pepper

# Optional: user-web base URL used in email links.
TREEBLOG_APP_BASE_URL=http://localhost:3000

# Optional SMTP relay (defaults point at local Mailpit).
# TREEBLOG_SMTP_HOST=localhost
# TREEBLOG_SMTP_PORT=1025
# TREEBLOG_SMTP_USERNAME=
# TREEBLOG_SMTP_PASSWORD=
# TREEBLOG_SMTP_FROM=no-reply@treeblog.local
# TREEBLOG_SMTP_USE_TLS=false

# Optional S3-compatible object storage (defaults point at local MinIO).
# TREEBLOG_S3_ENDPOINT=http://localhost:9000
# TREEBLOG_S3_REGION=us-east-1
# TREEBLOG_S3_ACCESS_KEY=
# TREEBLOG_S3_SECRET_KEY=
# TREEBLOG_S3_BUCKET_RAW=treeblog-raw-private
# TREEBLOG_S3_BUCKET_PUBLIC=treeblog-media-public
# TREEBLOG_S3_PUBLIC_BASE_URL=

# Optional OpenSearch ranked retrieval (empty disables it; SQL fallback serves search).
# TREEBLOG_OPENSEARCH_URL=http://localhost:9200
# TREEBLOG_OPENSEARCH_PREFIX=treeblog

# Optional social login (a provider without a client ID answers 501).
# TREEBLOG_OAUTH_REDIRECT_BASE=http://localhost:8080
# TREEBLOG_OAUTH_GOOGLE_CLIENT_ID=
# TREEBLOG_OAUTH_GOOGLE_CLIENT_SECRET=
# TREEBLOG_OAUTH_GITHUB_CLIENT_ID=
# TREEBLOG_OAUTH_GITHUB_CLIENT_SECRET=
# TREEBLOG_OAUTH_NAVER_CLIENT_ID=
# TREEBLOG_OAUTH_NAVER_CLIENT_SECRET=
# TREEBLOG_OAUTH_KAKAO_CLIENT_ID=
# TREEBLOG_OAUTH_KAKAO_CLIENT_SECRET=
# TREEBLOG_OAUTH_APPLE_CLIENT_ID=
# TREEBLOG_OAUTH_APPLE_TEAM_ID=
# TREEBLOG_OAUTH_APPLE_KEY_ID=
# TREEBLOG_OAUTH_APPLE_KEY_PATH=
# TREEBLOG_OAUTH_TREESCAN_CLIENT_ID=
# TREEBLOG_OAUTH_TREESCAN_CLIENT_SECRET=
# TREEBLOG_OAUTH_TREESCAN_ISSUER=

# Optional TreeScan feed API keys (comma-separated; empty disables the feed).
# TREEBLOG_TREESCAN_API_KEYS=

# Optional Toss Payments (empty disables payment confirmation).
# TREEBLOG_TOSS_SECRET_KEY=
# TREEBLOG_TOSS_CLIENT_KEY=
